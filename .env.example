# -----------------------------------------------------------------------------
# NEXORA Beauty & Essentials — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Every variable below is
# safe to expose to the browser (that's what VITE_ means — anything with
# that prefix is bundled into the public JS). Secrets that must NEVER go in
# this file, in any VITE_ variable, or in this repo at all are listed
# separately at the bottom — they only ever live in Supabase's Edge
# Function secrets, set via the Supabase CLI/dashboard.
# -----------------------------------------------------------------------------

# ===========================================================================
# PUBLIC — safe in this file, safe in the browser bundle, safe in GitHub.
# ===========================================================================

# Supabase project — see supabase/schema.sql and supabase/schema_additions.sql
# for the tables/policies/functions to run first (in that order).
# Found in Supabase dashboard -> Project Settings -> API.
# Without these two set, the app runs entirely on local mock data
# (localStorage) — a zero-setup demo mode, not a bug.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paystack PUBLIC (test or live) key, from Paystack dashboard -> Settings ->
# API Keys & Webhooks. This is the only Paystack key the browser is ever
# allowed to see — see PAYSTACK_SECRET_KEY below for why the secret key
# never belongs here.
VITE_PAYSTACK_PUBLIC_KEY=

# WhatsApp Business number in international format, digits only, no
# leading "+" (e.g. Nigerian mobile 0801 234 5678 -> 2348012345678).
VITE_WHATSAPP_NUMBER=

# Support email shown in the footer, Contact page, and order confirmation.
VITE_SUPPORT_EMAIL=

# Admin dashboard sign-in FALLBACK ONLY — used only when Supabase isn't
# configured above. When Supabase IS configured, admin sign-in goes through
# real Supabase Auth + the `profiles.role = 'admin'` check instead (see
# src/store/authStore.ts and schema_additions.sql), and these two values
# are ignored entirely. IMPORTANT: even as a fallback, this is a
# client-side-only gate, not real security — the value you set here ships
# inside the public JS bundle and anyone can read it by inspecting the
# built files. Fine for a no-backend demo; never treat it as protecting
# anything sensitive.
VITE_ADMIN_USERNAME=
VITE_ADMIN_PASSWORD=

# ===========================================================================
# SECRET — do NOT put these in this file, in any VITE_ variable, in React
# code, or in GitHub. Set them ONLY as Supabase Edge Function secrets:
#   supabase secrets set PAYSTACK_SECRET_KEY=sk_...
# SUPABASE_SERVICE_ROLE_KEY is provided automatically to every Edge
# Function by the Supabase platform — you never set it yourself.
# ===========================================================================
#
#   PAYSTACK_SECRET_KEY          Paystack dashboard -> Settings -> API Keys.
#                                 Read only by supabase/functions/checkout —
#                                 used to verify a payment actually succeeded
#                                 before an order is ever created as "paid".
#   SUPABASE_SERVICE_ROLE_KEY    Auto-provided to Edge Functions. Bypasses
#                                 every RLS policy — never expose this to the
#                                 browser, never put it in a VITE_ variable.
#
# If either of these ever ends up pasted into a chat, a file, an env var the
# browser can read, or committed to git, rotate it immediately in the
# Paystack/Supabase dashboard — treat it as compromised the moment it left
# a server-only secrets store.
