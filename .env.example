# -----------------------------------------------------------------------------
# NEXORA Beauty & Essentials — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Every variable is
# optional in the sense that the app runs fully without them (backed by
# local mock data / a "not configured" UI state) — but Supabase and
# Paystack must be set to go live with a real store.
# -----------------------------------------------------------------------------

# Supabase — see supabase/schema.sql for the tables to create first.
# Found in Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paystack — public/test key from the Paystack dashboard → Settings → API Keys & Webhooks.
# Never put your Paystack SECRET key in a VITE_ variable — secret keys must
# only ever live server-side (e.g. a Supabase Edge Function that verifies
# transactions), because anything prefixed VITE_ is bundled into the
# client-side JavaScript and is publicly visible.
VITE_PAYSTACK_PUBLIC_KEY=

# WhatsApp Business number in international format, digits only, no
# leading "+" (e.g. Nigerian mobile 0801 234 5678 -> 2348012345678).
VITE_WHATSAPP_NUMBER=

# Support email shown in the footer, Contact page, and order confirmation.
VITE_SUPPORT_EMAIL=

# Admin dashboard sign-in (/admin). IMPORTANT: this is a client-side-only
# gate, not real security — the value you set here ships inside the public
# JS bundle and anyone can read it by inspecting the built files. It's
# enough to keep casual visitors out of day-to-day store management, but
# do not treat it as protecting anything sensitive. Change these from the
# defaults before sharing your store's URL, and replace with real
# server-side auth (Supabase Auth) if this dashboard will ever hold data
# you actually need to keep private.
VITE_ADMIN_USERNAME=
VITE_ADMIN_PASSWORD=
